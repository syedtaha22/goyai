# Copy this file to .env and edit it.
# Every variable is optional, and the values below are the defaults.


# --- Model server ---

# Ollama model tag used for suggestions. Run `ollama pull <tag>` before using it.
GOYAI_MODEL=qwen3.5:4b

# Address of the Ollama server.
GOYAI_OLLAMA_URL=http://localhost:11434

# How long Ollama keeps the model in memory after the last request.
GOYAI_KEEP_ALIVE=30m

# Seconds allowed for loading the model at startup.
GOYAI_WARMUP_TIMEOUT=120


# --- Generation ---

# Sampling randomness for a first request. Lower is more predictable.
GOYAI_TEMPERATURE=0.3

# Sampling randomness for "different suggestions" requests.
GOYAI_TEMPERATURE_DIFFERENT=0.8

# Context window in tokens. Smaller is faster and uses less VRAM.
GOYAI_NUM_CTX=4096

# Maximum tokens the model may generate per response.
GOYAI_NUM_PREDICT=512


# Fixed sampling seed for reproducible runs. Leave unset for random sampling.
# GOYAI_SEED=0


# --- Time limits ---

# Seconds to wait for one model response before giving up.
GOYAI_REQUEST_TIMEOUT=20

# Total seconds a request may spend on the model, retries included,
# before the curated fallback answers.
GOYAI_LLM_BUDGET=8


# --- Application ---

# Log verbosity: DEBUG, INFO, WARNING or ERROR.
GOYAI_LOG_LEVEL=INFO

# Browser origins allowed to call the API, as a JSON list.
GOYAI_CORS_ORIGINS=["http://localhost:3000"]
