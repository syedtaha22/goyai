# Copy to .env and edit. Every variable is optional; the values below are the defaults.

GOYAI_MODEL=qwen3.5:4b
GOYAI_OLLAMA_URL=http://localhost:11434
GOYAI_REQUEST_TIMEOUT=20
GOYAI_WARMUP_TIMEOUT=120
GOYAI_KEEP_ALIVE=30m
GOYAI_NUM_CTX=4096
GOYAI_NUM_PREDICT=512
GOYAI_LOG_LEVEL=INFO
GOYAI_CORS_ORIGINS=["http://localhost:3000"]
